# ------------------------------------------------------------------
# PulseGraph backend configuration - copy to .env and adjust.
# Every value below is read at startup; real environment variables
# always take precedence over the .env file.
# ------------------------------------------------------------------

# -- Application ---------------------------------------------------
APP_ENV=development
APP_PORT=8080
CORS_ORIGINS=*
RUN_MIGRATIONS=true
LOG_LEVEL=info

# -- PostgreSQL ----------------------------------------------------
DATABASE_URL=postgres://pulsegraph:pulsegraph@localhost:5432/pulsegraph?sslmode=disable
POSTGRES_MAX_CONNS=10

# -- Redis (cache + Redis Streams pipeline) ------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=60s

# -- Authentication ------------------------------------------------
JWT_SECRET=change-me-before-deploying
JWT_TTL=24h
JWT_ISSUER=pulsegraph

# -- Python AI microservices ---------------------------------------
ML_SENTIMENT_URL=http://localhost:8001
ML_EMBEDDING_URL=http://localhost:8002
ML_SUMMARIZER_URL=http://localhost:8003
ML_TIMEOUT=15s

# -- Search (Elasticsearch / OpenSearch abstraction) ---------------
SEARCH_ENABLED=false
SEARCH_URL=http://localhost:9200
SEARCH_INDEX=pulsegraph-posts
SEARCH_USERNAME=
SEARCH_PASSWORD=

# -- Event pipeline ------------------------------------------------
PIPELINE_STREAM_PREFIX=pulsegraph
PIPELINE_CONSUMER_GROUP=pulsegraph-workers
PIPELINE_BATCH_SIZE=16
PIPELINE_BLOCK=2s
PIPELINE_MAX_RETRIES=3

# -- Demo / local operation ----------------------------------------
DEMO_INGEST_ENABLED=false
DEMO_INGEST_INTERVAL=30s
SCHEDULE_INTERVAL=2m
